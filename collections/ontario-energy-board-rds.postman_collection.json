{
  "item": [
    {
      "id": "91f235ca-7030-4400-a1dc-29c66964f557",
      "name": "Records",
      "description": {
        "content": "Search and retrieve records (filings, decisions, orders, licences, correspondence) in the OEB case record.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "daa6b83a-90e1-48f3-825a-7bb085d4cf71",
          "name": "Search the OEB regulatory document record",
          "request": {
            "name": "Search the OEB regulatory document record",
            "description": {
              "content": "Runs a Content Manager record search and returns matching records. With `format=json` the response is a Content Manager `TRIMServiceAPIModel` payload; without it the same query renders an HTML results page. Results carry the OEB's own regulatory fields — CaseNumber, SIDocumentType, Applicant, EnergyType, PrimaryApplicationType, DateIssued, fDateReceived.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "Record"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "q",
                  "value": "<string>",
                  "description": "(Required) Search clause. Use `<term>=<value>` for comparison or `<term>:<value>` for word/contains matching. The complete set of 303 valid terms is published live at /Help/WDSearchClauseDefJS?trimType=Record and captured in vocabulary/ontario-energy-board-rds-search-clauses.yml."
                },
                {
                  "disabled": false,
                  "key": "format",
                  "value": "<string>",
                  "description": "Response projection. `json` returns application/json; omitted returns the HTML results page."
                },
                {
                  "disabled": false,
                  "key": "sortBy",
                  "value": "<string>",
                  "description": "Sort clause; a trailing `-` sorts descending. 87 of the 303 clauses are sortable (`CanSort: true` in the clause definitions). This is the parameter the OEB's own website links use."
                },
                {
                  "disabled": false,
                  "key": "pageSize",
                  "value": "<integer>",
                  "description": "Number of records returned in this page. Values from 1 to 400 were observed in OEB-authored links."
                },
                {
                  "disabled": false,
                  "key": "start",
                  "value": "<integer>",
                  "description": "1-based index of the first record to return; the paging cursor for `pageSize`."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
          "response": [
            {
              "id": "4ceabdd9-f935-4031-955d-3bc3726cf0f2",
              "name": "Search executed. NOTE — a rejected or malformed clause also returns 200 with an empty `Results` array and the reason in plain English in `SearchTitle`, not an HTTP error status.",
              "originalRequest": {
                "url": {
                  "path": [
                    "Record"
                  ],
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "query": [
                    {
                      "key": "q",
                      "value": "CaseNumber=EB-2021-0183"
                    },
                    {
                      "key": "format",
                      "value": "json"
                    },
                    {
                      "key": "sortBy",
                      "value": "recRegisteredOn-"
                    },
                    {
                      "key": "pageSize",
                      "value": "400"
                    },
                    {
                      "key": "start",
                      "value": "2"
                    }
                  ],
                  "variable": []
                },
                "header": [
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "method": "GET",
                "body": {}
              },
              "status": "OK",
              "code": 200,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"summary\": \"Two records from case EB-2021-0183\",\n  \"externalValue\": \"examples/ontario-energy-board-rds-record-search-response.json\"\n}",
              "cookie": [],
              "_postman_previewlanguage": "json"
            }
          ],
          "event": [],
          "protocolProfileBehavior": {
            "disableBodyPruning": true
          }
        },
        {
          "id": "e49c41cc-c284-4b26-a7cd-c54c8eff9391",
          "name": "Retrieve a single record by Content Manager URI",
          "request": {
            "name": "Retrieve a single record by Content Manager URI",
            "description": {
              "content": "Record detail by URI. Observed to fail for an anonymous caller — the server attempts to resolve `RecordContainer` and returns HTTP 500 carrying a `TrimException` in `ResponseStatus`. The document bytes are nevertheless reachable anonymously through the `/File/document` sub-resource below. Recorded because it was probed, not because it works.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "Record",
                ":uri"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "format",
                  "value": "<string>"
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<integer>",
                  "key": "uri",
                  "description": "(Required) Content Manager record URI, an opaque integer returned as `Uri` on every search hit."
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
          "response": [
